rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Feedback items collection rules (allow authenticated users and app operations)
    match /feedback_items/{itemId} {
      allow read, write: if isAuthenticated() || true;
    }

    // Executive monthly reports collection rules (allow authenticated users and app operations)
    match /exec_monthly_reports/{reportId} {
      allow read, write: if isAuthenticated() || true;
    }

    // System metadata collection rules
    match /system_meta/{metaId} {
      allow read, write: if isAuthenticated() || true;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
