{
  "entities": [
    {
      "name": "FeedbackItem",
      "collectionName": "feedback_items",
      "description": "Customer feedback records including WB cases, category classification, and action tracking.",
      "fields": [
        { "name": "id", "type": "string", "description": "Unique record ID / case number" },
        { "name": "caseNumber", "type": "string", "description": "WB or FB Case number" },
        { "name": "caseStatus", "type": "string", "description": "Case lifecycle status (Closed, Open, etc.)" },
        { "name": "date", "type": "string", "description": "Visit date (ISO YYYY-MM-DD)" },
        { "name": "monthYear", "type": "string", "description": "Month-Year partition string (e.g. August 2026)" },
        { "name": "type", "type": "string", "description": "Feedback categorization (Complaint, Compliment, Thank You, Suggestion)" },
        { "name": "department", "type": "string", "description": "Department code / name" },
        { "name": "venue", "type": "string", "description": "Venue / location" },
        { "name": "tableName", "type": "string", "description": "Report table / section" },
        { "name": "feedbackDetail", "type": "string", "description": "Detailed customer feedback text" },
        { "name": "status", "type": "string", "description": "Action item status (Pending, In Progress, Resolved)" },
        { "name": "actionTaken", "type": "string", "description": "Action log / resolution notes" },
        { "name": "actionOwner", "type": "string", "description": "Assigned action owner" },
        { "name": "actionDueDate", "type": "string", "description": "Action target due date" },
        { "name": "updatedAt", "type": "number", "description": "Timestamp of last modification" }
      ]
    }
  ]
}
